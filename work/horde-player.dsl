(event `ShowGunShot`
  (if (`self.IsPistol`)
    (`GameplayStatics.PlaySound2D` "/Game/OneMoreTake/Audio/S_PistolShot.S_PistolShot" 0.55)
    (else (`GameplayStatics.PlaySound2D` "/Game/OneMoreTake/Audio/S_Gunshot.S_Gunshot" 0.4)))
  (if (> (`KismetMathLibrary.VSize` (- (`self.GunShotEnd`) (`self.GunShotStart`))) 1.0)
    (`SceneComponent.K2_SetWorldLocationAndRotation` (`self.GunTracer`) (* (+ (`self.GunShotStart`) (`self.GunShotEnd`)) 0.5) (`KismetMathLibrary.FindLookAtRotation` (`self.GunShotStart`) (`self.GunShotEnd`)) false true)
    (`SceneComponent.SetWorldScale3D` (`self.GunTracer`) (`KismetMathLibrary.MakeVector` (/ (`KismetMathLibrary.VSize` (- (`self.GunShotEnd`) (`self.GunShotStart`))) 100.0) 0.025 0.025))
    (`SceneComponent.SetVisibility` (`self.GunTracer`) true false))
  (`SceneComponent.SetVisibility` (`self.MuzzleFlash`) true false)
  (`KismetSystemLibrary.Delay` 0.055)
  (`SceneComponent.SetVisibility` (`self.GunTracer`) false false)
  (`SceneComponent.SetVisibility` (`self.MuzzleFlash`) false false))
(event `ReloadPistol`
  (if (and (< (`self.PistolAmmo`) 6) (`self.IsPistol`) (not (`self.IsReloading`)) (not (`self.IsDead`)) (not (`self.SceneLocked`)))
    (set `self.IsReloading` true)
    (`GameplayStatics.PlaySound2D` "/Game/OneMoreTake/Audio/S_PistolReload.S_PistolReload" 0.55)
    (set `self.PreReloadMoveSpeed` (`CharacterMovementComponent.MaxWalkSpeed` (`self.CharacterMovement`)))
    (set `CharacterMovementComponent.MaxWalkSpeed` (* (`self.PreReloadMoveSpeed`) 0.65) (`self.CharacterMovement`))
    (`AnimInstance.PlaySlotAnimationAsDynamicMontage` (`SkeletalMeshComponent.GetAnimInstance` (`self.Mesh`)) "/Game/OneMoreTake/Animations/Retargeted/Pistol/A_PistolReload.A_PistolReload" "DefaultSlot" 0.1 0.14 (/ 1.8 (`self.PistolReloadDuration`)) 1 -1.0 0.0)
    (`KismetSystemLibrary.Delay` (`self.PistolReloadDuration`))
    (if (and (not (`self.IsDead`)) (not (`self.SceneLocked`)))
      (set `self.PistolAmmo` 6))
    (set `CharacterMovementComponent.MaxWalkSpeed` (`self.PreReloadMoveSpeed`) (`self.CharacterMovement`))
    (set `self.IsReloading` false)))

(event `self.ReceiveBeginPlay`
 (if (!= (`GameplayStatics.ParseOption` (`GameModeBase.OptionsString` (`GameplayStatics.GetGameMode`)) "Take") "4")
  (`self.K2_DestroyActor`)
  (else
   (set `self.PlayerRef` (cast `/Game/OneMoreTake/Blueprints/BP_KnightPlayer` (`GameplayStatics.GetPlayerCharacter` 0)))
   (set `self.DirectorRef` (cast `/Game/OneMoreTake/Blueprints/BP_TakeDirector` (`GameplayStatics.GetActorOfClass` "/Game/OneMoreTake/Blueprints/BP_TakeDirector.BP_TakeDirector_C")))
   (set `self.AttackState` 0) (set `self.RunsCompleted` 0) (set `self.NextRunDelay` 4.0))))
(event `self.ReceiveTick`
 (params (DeltaSeconds :type "Float (single-precision)"))
 (bind p (cast `/Game/OneMoreTake/Blueprints/BP_KnightPlayer` (`self.PlayerRef`)))
 (bind d (cast `/Game/OneMoreTake/Blueprints/BP_TakeDirector` (`self.DirectorRef`)))
 (if (and (not (`/Game/OneMoreTake/Blueprints/BP_KnightPlayer.IsDead` p)) (== (`/Game/OneMoreTake/Blueprints/BP_TakeDirector.Stage` d) 0))
  (if (== (`self.AttackState`) 0)
   (set `self.NextRunDelay` (- (`self.NextRunDelay`) DeltaSeconds))
   (if (<= (`self.NextRunDelay`) 0.0) (`self.BeginPass`))
   (elif (== (`self.AttackState`) 1)
    (set `self.StateTime` (- (`self.StateTime`) DeltaSeconds))
    (if (<= (`self.StateTime`) 0.0) (`self.BeginFlight`))
    (elif (== (`self.AttackState`) 2)
     (set `self.FlightTime` (+ (`self.FlightTime`) DeltaSeconds))
     (set `self.JetX` (+ -2400.0 (* 1600.0 (`self.FlightTime`))))
     (`SceneComponent.K2_SetRelativeLocation` (`self.Jet`) (`KismetMathLibrary.MakeVector` (`self.JetX`) 0.0 350.0) false true)
     (`SceneComponent.K2_SetRelativeLocation` (`self.CannonTracer`) (`KismetMathLibrary.MakeVector` (`self.JetX`) 0.0 180.0) false true)
     (`SceneComponent.SetVisibility` (`self.CannonTracer`) false false)
     (if (and (>= (`self.JetX`) -1100.0) (<= (`self.JetX`) 1100.0))
      (set `self.ImpactIndex` (`KismetMathLibrary.FTrunc` (/ (+ (`self.JetX`) 1100.0) 125.0)))
      (if (> (`self.ImpactIndex`) (`self.LastImpactIndex`))
       (set `self.LastImpactIndex` (`self.ImpactIndex`))
       (`self.StrafeImpact`)
       (`SceneComponent.SetVisibility` (`self.CannonTracer`) true false)))
     (if (>= (`self.FlightTime`) 3.1) (`self.EndPass`)))))
  (else
   (`self.ShowWarning` false)
   (`SceneComponent.SetVisibility` (`self.Jet`) false false)
   (`SceneComponent.SetVisibility` (`self.CannonTracer`) false false))))
(event `ShowWarning`
 (params (Visible :type Boolean))
 (`SceneComponent.SetVisibility` (`self.DangerStrip`) Visible false)
 (`SceneComponent.SetVisibility` (`self.BorderLeft`) Visible false)
 (`SceneComponent.SetVisibility` (`self.BorderRight`) Visible false)
 (`SceneComponent.SetVisibility` (`self.Stripe0`) Visible false)
 (`SceneComponent.SetVisibility` (`self.Stripe1`) Visible false)
 (`SceneComponent.SetVisibility` (`self.Stripe2`) Visible false)
 (`SceneComponent.SetVisibility` (`self.Stripe3`) Visible false)
 (`SceneComponent.SetVisibility` (`self.Stripe4`) Visible false)
 (`SceneComponent.SetVisibility` (`self.Stripe5`) Visible false)
 (`SceneComponent.SetVisibility` (`self.Stripe6`) Visible false))
(event `BeginPass`
 (set `self.AttackState` 1)
 (set `self.StateTime` (`self.WarningDuration`))
 (set `self.PlayerHitThisRun` false)
 (set `self.LastImpactIndex` -1)
 (`self.K2_SetActorLocation` (`KismetMathLibrary.MakeVector` (.x (`self.K2_GetActorLocation` (`self.PlayerRef`))) (.y (`self.K2_GetActorLocation` (`self.PlayerRef`))) 0.0) false true)
 (`self.K2_SetActorRotation` (`KismetMathLibrary.MakeRotator` 0.0 0.0 (`KismetMathLibrary.SelectFloat` (`KismetMathLibrary.RandomFloatInRange` 55.0 115.0) (`KismetMathLibrary.RandomFloatInRange` -125.0 -65.0) (`self.ReverseRun`))) false)
 (set `self.ReverseRun` (not (`self.ReverseRun`)))
 (`self.ShowWarning` true)
 (`GameplayStatics.PlaySound2D` "/Game/OneMoreTake/Audio/S_StrafeAlert.S_StrafeAlert" 0.45))
(event `BeginFlight`
 (set `self.AttackState` 2) (set `self.FlightTime` 0.0)
 (`SceneComponent.K2_SetRelativeLocation` (`self.Jet`) (-2400.0 0.0 350.0) false true)
 (`SceneComponent.SetVisibility` (`self.Jet`) true false)
 (`GameplayStatics.PlaySound2D` "/Game/OneMoreTake/Audio/S_JetFlyby.S_JetFlyby" 0.4)
 (`KismetSystemLibrary.Delay` 0.8)
 (`GameplayStatics.PlaySound2D` "/Game/OneMoreTake/Audio/S_StrafeCannon.S_StrafeCannon" 0.3))
(event `StrafeImpact`
 (set `self.ImpactPoint` (+ (`self.K2_GetActorLocation`) (* (`self.GetActorForwardVector`) (`self.JetX`))))
 (bind transform (`KismetMathLibrary.MakeTransform` (`self.ImpactPoint`) (struct) (1.0 1.0 1.0)))
 (bind impact (`|SpawnActorFromClass` "/Game/OneMoreTake/Blueprints/BP_StrafeImpact.BP_StrafeImpact_C" transform "AlwaysSpawn" :`Owner` self))
 (if (and (not (`self.PlayerHitThisRun`)) (< (`KismetMathLibrary.VSize` (- (`KismetMathLibrary.MakeVector` (.x (`self.K2_GetActorLocation` (`self.PlayerRef`))) (.y (`self.K2_GetActorLocation` (`self.PlayerRef`))) 0.0) (`self.ImpactPoint`))) 140.0))
  (set `self.PlayerHitThisRun` true)
  (`GameplayStatics.ApplyDamage` (`self.PlayerRef`) 35.0 null self)))
(event `EndPass`
 (`self.ShowWarning` false)
 (`SceneComponent.SetVisibility` (`self.Jet`) false false)
 (`SceneComponent.SetVisibility` (`self.CannonTracer`) false false)
 (if (< (`self.RunsCompleted`) 4) (`self.SpawnReinforcements`))
 (set `self.RunsCompleted` (+ (`self.RunsCompleted`) 1))
 (if (< (`self.RunsCompleted`) (`self.RequiredRuns`))
  (set `self.AttackState` 0) (set `self.NextRunDelay` (`self.RunCooldown`))
  (else (set `self.AttackState` 3))))
(event `SpawnReinforcements`
 (set `self.SpawningEnemies` true)
 (set `self.SpawnLoopIndex` 0)
 (set `self.SpawnTotalCount` (+ 3 (`self.RunsCompleted`)))
 (`self.SpawnNextEnemy`))
(event `SpawnNextEnemy`
 (bind p (cast `/Game/OneMoreTake/Blueprints/BP_KnightPlayer` (`self.PlayerRef`)))
 (if (not (`/Game/OneMoreTake/Blueprints/BP_KnightPlayer.IsDead` p))
  (set `self.SpawnPoint` (+ (`self.K2_GetActorLocation` (`self.PlayerRef`)) (* (`KismetMathLibrary.Normal` (`KismetMathLibrary.MakeVector` (`KismetMathLibrary.RandomFloatInRange` -1.0 1.0) (`KismetMathLibrary.RandomFloatInRange` -1.0 1.0) 0.0)) 1000.0)))
  (set `self.SpawnPoint` (`KismetMathLibrary.MakeVector` (.x (`self.SpawnPoint`)) (.y (`self.SpawnPoint`)) 92.0))
  (if (and (> (.x (`self.SpawnPoint`)) 440.0) (< (.x (`self.SpawnPoint`)) 1050.0) (> (.y (`self.SpawnPoint`)) 100.0) (< (.y (`self.SpawnPoint`)) 1250.0))
   (set `self.SpawnPoint` (+ (`self.SpawnPoint`) (0.0 1250.0 0.0))))
  (bind transform (`KismetMathLibrary.MakeTransform` (`self.SpawnPoint`) (struct) (1.0 1.0 1.0)))
  (if (< (`self.SpawnLoopIndex`) (`KismetMathLibrary.SelectInt` 2 1 (>= (`self.RunsCompleted`) 2)))
   (bind enemy (`|SpawnActorFromClass` "/Game/OneMoreTake/Blueprints/BP_Guard.BP_Guard_C" transform "AlwaysSpawn" :`Owner` self :`FinalTakeEnemy` true))
   (bind knight (cast `/Game/OneMoreTake/Blueprints/BP_KnightPlayer` enemy))
   (set `/Game/OneMoreTake/Blueprints/BP_KnightPlayer.FinalTakeEnemy` true knight)
   (set `/Game/OneMoreTake/Blueprints/BP_KnightPlayer.Health` 80.0 knight)
   (else
    (bind undead (`|SpawnActorFromClass` "/Game/OneMoreTake/Blueprints/BP_WaveZombie.BP_WaveZombie_C" transform "AlwaysSpawn" :`Owner` self :`FinalTakeEnemy` true))
    (bind zombie (cast `/Game/OneMoreTake/Blueprints/BP_KnightPlayer` undead))
    (set `/Game/OneMoreTake/Blueprints/BP_KnightPlayer.FinalTakeEnemy` true zombie)
    (set `/Game/OneMoreTake/Blueprints/BP_KnightPlayer.Health` 60.0 zombie)
    (set `/Game/OneMoreTake/Blueprints/BP_KnightPlayer.ZombieWaveIndex` 2 zombie)
    (`/Game/OneMoreTake/Blueprints/BP_KnightPlayer.WakeZombie` zombie)))
  (set `self.SpawnLoopIndex` (+ (`self.SpawnLoopIndex`) 1))
  (if (< (`self.SpawnLoopIndex`) (`self.SpawnTotalCount`))
   (`KismetSystemLibrary.Delay` 0.65) (`self.SpawnNextEnemy`)
   (else (set `self.SpawningEnemies` false)))))



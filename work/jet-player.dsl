(event `self.ReceiveBeginPlay`
 (`TextRenderComponent.SetFont` (`self.AttackWarning`) "/Game/Fonts/Alagard_World.Alagard_World")
 (`TextRenderComponent.SetTextMaterial` (`self.AttackWarning`) "/Game/OneMoreTake/Materials/M_AlagardWorldTextEngine.M_AlagardWorldTextEngine")
 (`TextRenderComponent.SetFont` (`self.ZombieLabel`) "/Game/Fonts/Alagard_World.Alagard_World")
 (`TextRenderComponent.SetTextMaterial` (`self.ZombieLabel`) "/Game/OneMoreTake/Materials/M_AlagardWorldTextEngine.M_AlagardWorldTextEngine")
  (set `self.DodgeReady` true)
  (set `self.GunReady` true)
  (set `self.MagicReady` true)
  (set `self.NormalMeshMaterials` (`MeshComponent.GetMaterials` (`self.Mesh`)))
  (if (not (`self.IsEnemy`))
    (`PrimitiveComponent.SetCollisionEnabled` (`self.BulletHitbox`) "NoCollision"))
  (if (`self.IsEnemy`)
    (`SkeletalMeshComponent.SetAnimInstanceClass` (`self.Mesh`) "/Game/OneMoreTake/Animations/ABP_GuardStrafe.ABP_GuardStrafe_C")
    (set `CharacterMovementComponent.bOrientRotationToMovement` false (`self.CharacterMovement`))
    (if (`KismetMathLibrary.RandomBool`)
      (set `self.OrbitDirection` 1.0)
      (else
        (set `self.OrbitDirection` -1.0))))
  (if (== (`GameplayStatics.ParseOption` (`GameModeBase.OptionsString` (`GameplayStatics.GetGameMode`)) "Take") "4")
 (if (`self.IsEnemy`)
  (if (not (`self.FinalTakeEnemy`)) (`self.K2_DestroyActor`)
   (elif (`self.IsWaveZombie`) (`self.InitializeWaveZombie`))))
 (else (if (== (`GameplayStatics.ParseOption` (`GameModeBase.OptionsString` (`GameplayStatics.GetGameMode`)) "Take") "3")
    (if (`self.IsWaveZombie`)
      (`self.InitializeWaveZombie`)
      (elif (`self.IsEnemy`)
        (`self.K2_DestroyActor`)
        (else
          (`self.EquipGun`))))
    (elif (`self.IsWaveZombie`)
      (`self.K2_DestroyActor`)
      (elif (== (`GameplayStatics.ParseOption` (`GameModeBase.OptionsString` (`GameplayStatics.GetGameMode`)) "Take") "2")
        (if (not (`self.IsEnemy`))
          (`self.EquipGun`))
        (elif (`self.ExtraTakeTwoGuard`)
          (`self.K2_DestroyActor`))))))))
(event `RestartCurrentTake`
 (if (== (`GameplayStatics.ParseOption` (`GameModeBase.OptionsString` (`GameplayStatics.GetGameMode`)) "Take") "4")
  (`GameplayStatics.OpenLevel` "L_MovieSet" true "Take=4")
  (else (if (== (`GameplayStatics.ParseOption` (`GameModeBase.OptionsString` (`GameplayStatics.GetGameMode`)) "Take") "3")
    (`GameplayStatics.OpenLevel` "L_MovieSet" true "Take=3")
    (elif (`self.HasGun`)
      (`GameplayStatics.OpenLevel` "L_MovieSet" true "Take=2")
      (else
        (`GameplayStatics.OpenLevel` "L_MovieSet" true "Take=1")))))))